{
  "uid": "kart-metrics",
  "title": "Kart Metrics",
  "description": "Infra health across all Kart services, shipped via OTLP to Prometheus: request rate/errors/latency, .NET memory and GC, and request/thread-pool saturation. CPU and database metrics aren't instrumented anywhere in the platform yet, so they're intentionally left out rather than shown empty.",
  "tags": ["kart", "metrics", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(service_name)",
        "definition": "label_values(service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0,
        "skipUrlSync": false,
        "regex": "",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "traceid",
        "type": "textbox",
        "label": "Trace ID",
        "description": "Not wired to any panel here -- no metric in this stack carries trace-level granularity. Kept for consistency with the Logs/Tracing dashboards; paste it into Kart Tracing to view the actual trace.",
        "query": "",
        "hide": 0,
        "skipUrlSync": false,
        "current": { "selected": false, "text": "", "value": "" },
        "options": [{ "selected": true, "text": "", "value": "" }]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{exported_job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error Rate",
      "description": "5xx responses as a share of total requests, per service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{exported_job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P95 Latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, exported_job) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{exported_job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": ".NET Heap Memory",
      "description": "Managed GC heap size per service (process RSS/CPU aren't instrumented in this stack).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_runtime_dotnet_gc_heap_size_bytes{exported_job=~\"$service\"}",
          "legendFormat": "{{exported_job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GC Collections Rate",
      "description": "Garbage collections per second, by generation.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (exported_job, generation) (rate(process_runtime_dotnet_gc_collections_count_total{exported_job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{exported_job}} - {{generation}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active HTTP Requests",
      "description": "In-flight requests per service -- a leading saturation signal.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "http_server_active_requests{exported_job=~\"$service\"}",
          "legendFormat": "{{exported_job}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Thread Pool Queue Length",
      "description": "Work items waiting on the .NET thread pool -- a rising queue means the service can't keep up.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_runtime_dotnet_thread_pool_queue_length{exported_job=~\"$service\"}",
          "legendFormat": "{{exported_job}}"
        }
      ]
    }
  ]
}
