# Single source of truth for every host port this platform's local-dev tooling uses — the
# canonical registry every other file (docker-compose.yml here and in each kart-*-service's own
# repo, every service's launchSettings.json/appsettings.Development.json, kart-web's and
# kart-admin-web's .env.example/proxy.conf.json/app-config.ts) is documented as mirroring.
#
# Not a secret — safe to commit (unlike compose/globalconfig/, which holds generated per-machine
# credentials). Change a port ONLY here, then propagate: this file drives docker-compose.yml's
# own `${..._PORT}` interpolation directly; every other consumer (a separate process/language
# that can't read this file at runtime) needs its own literal updated to match — see
# README.md's "Ports" section for the full list of what to touch.
#
# Loaded via `docker compose --env-file ports.env ...` (scripts/dev-up.sh / dev-down.sh /
# dev-logs.sh already do this) rather than named `.env`, so it isn't caught by the blanket
# `.env`/`.env.*` gitignore rule this repo's .gitignore inherits from the standard Node template.

# --- Backend services (host port; every container still listens on 8080 internally) ---
IDENTITY_PORT=8081
USER_PORT=8082
PRODUCT_PORT=8083
CATEGORY_PORT=8084
SEARCH_PORT=8085
INVENTORY_PORT=8086
CART_PORT=8087
ORDER_PORT=8088
PAYMENT_PORT=8089
OFFER_PORT=8090
WISHLIST_PORT=8091
NOTIFICATION_PORT=8092
DELIVERY_TRACKING_PORT=8093
ADMIN_PORT=8094
RECOMMENDATION_PORT=8095

# --- Edge ---
GATEWAY_PORT=8100

# --- Frontend (host port; each container listens on 4000 internally) ---
WEB_PORT=4210
ADMIN_WEB_PORT=4300

# --- Shared infra (host port; see README.md for why these are shifted off their defaults) ---
POSTGRES_PORT=5433
MONGO_PORT=27018
REDIS_PORT=6380
RABBITMQ_AMQP_PORT=5673
RABBITMQ_UI_PORT=15672
OPENSEARCH_PORT=9200
# kart-recommendation-service's own consumed input (design-decisions.md's split-transport
# decision: clickstream is Kafka, not RabbitMQ) - the platform's first Kafka usage, single-node
# KRaft mode (no Zookeeper). Shifted off 9092 same reasoning as the other shared infra above.
KAFKA_PORT=9093
