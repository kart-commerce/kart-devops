# Copy this file to infra.env (gitignored, same directory) -- docker-compose.yml's shared
# postgres/rabbitmq containers read their bootstrap user/password from these vars instead of
# having them written directly into docker-compose.yml (which is committed to git). Same
# treatment as globalconfig.local.env (see that file's own comment / README.md) applied to the
# infra containers' own credentials instead of GlobalConfig's path.
#
# scripts/dev-up.sh copies this file to infra.env automatically on first run if it's missing, so
# the defaults below are safe to keep as-is for local dev -- these are throwaway containers only
# reachable from your own machine (compose/globalconfig/README's "not a security boundary" note
# applies here too), not real secrets. Change them only if you want non-default local creds.
#
# IMPORTANT: these MUST match the credentials already baked into every per-service connection
# string / Global.RabbitMq block in your own compose/globalconfig/global.json (copied from
# compose/globalconfig/global.json.example) -- that file is what services actually authenticate
# with. Changing a value here without updating global.json to match will make every service fail
# to connect to Postgres/RabbitMQ.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_DEFAULT_USER=kart
RABBITMQ_DEFAULT_PASS=kart123
