# Copy this file to globalconfig.local.env (gitignored, same directory) and point GLOBALCONFIG_PATH
# at your own Docker-flavored GlobalConfig JSON file -- the one every app container in
# docker-compose.yml mounts at /app/globalconfig.json (see docker-compose.yml's `${GLOBALCONFIG_PATH}`
# volume entries). Required shape: compose/globalconfig/global.json.example.
#
# Deliberately kept out of docker-compose.yml itself and out of ports.env (that file is
# committed/shared) -- this repo has no opinion on where your real file lives or what it's named;
# only you and this one gitignored line know. scripts/dev-up.sh sources this the same way it
# sources ports.env, so GLOBALCONFIG_PATH is a real exported shell var by the time `docker
# compose` reads it -- no --env-file plumbing needed beyond what dev-up.sh already does.
GLOBALCONFIG_PATH=/absolute/path/to/your/globalconfig.json
